{
  "name": "@outboundiq/client",
  "version": "0.0.0",
  "description": "Official TypeScript SDK for the outboundIQ platform: ANI assignment, dial ingestion, custom dialer integration, NRM, live feed, and webhook verification.",
  "keywords": [
    "outboundiq",
    "outboundani",
    "ani",
    "caller-id",
    "dialer",
    "contact-center",
    "nrm",
    "sdk"
  ],
  "license": "MIT",
  "author": "outboundIQ (https://outboundiq.com)",
  "homepage": "https://docs.outboundiq.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outboundani/typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/outboundani/typescript-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^22.10.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
